# Backend configuration
PORT=3001
FRONTEND_URL=http://localhost:5173
NODE_ENV=production

# Frontend API origin (used at build time by Vite)
# Put this in frontend/.env.production for a production frontend build.
# VITE_API_URL=https://${API_DOMAIN}

# Sandbox image built from backend/Dockerfile.sandbox
SANDBOX_IMAGE=cforge-sandbox:gcc14-c11
COMPILER=GCC
C_STANDARD=c11
MAX_CONCURRENT_JOBS=4
DOCKER_BINARY=docker

MAX_CODE_SIZE=262144
MAX_INPUT_SIZE=65536
MAX_OUTPUT_SIZE=1048576
MAX_REQUEST_BODY_SIZE=384kb

TIMEOUT_SECONDS=10
COMPILE_TIMEOUT_SECONDS=10
SANDBOX_MEMORY=256m
SANDBOX_CPUS=1.0
SANDBOX_PIDS_LIMIT=64
SANDBOX_TMPFS_SIZE=32m

RATE_LIMIT_WINDOW_SECONDS=60
RATE_LIMIT_MAX_REQUESTS=30
# Enable only when every request reaches this backend through a trusted proxy.
TRUST_PROXY=false
